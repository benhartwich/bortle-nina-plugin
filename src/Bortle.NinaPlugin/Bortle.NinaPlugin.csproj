<Project Sdk="Microsoft.NET.Sdk">

  <!-- The NINA side: subscribes to NINA's events, keeps the settings, offers
       the "Finish Bortle session" instruction. Builds on Windows (NINA is a
       WPF application); EnableWindowsTargeting lets CI compile it on Linux. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Bortle.NinaPlugin</AssemblyName>
    <RootNamespace>Bortle.NinaPlugin</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- NINA loads its own copies of these; the plugin folder carries only ours. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- NINA's own packages pull in .NET Framework libraries; NINA ships them. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" />
    <PackageReference Include="NINA.Core" Version="3.2.0.9001" />
    <PackageReference Include="NINA.Profile" Version="3.2.0.9001" />
    <PackageReference Include="NINA.Image" Version="3.2.0.9001" />
    <PackageReference Include="NINA.Sequencer" Version="3.2.0.9001" />
    <PackageReference Include="NINA.WPF.Base" Version="3.2.0.9001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bortle.Capture.Core\Bortle.Capture.Core.csproj" />
  </ItemGroup>

</Project>
